# --- Database ---------------------------------------------------------------
# Local dev default (no external services): SQLite
MODELFORGE_DATABASE_URL=sqlite+aiosqlite:///./modelforge.db
# Docker Compose / Postgres:
# MODELFORGE_DATABASE_URL=postgresql+asyncpg://modelforge:modelforge@db:5432/modelforge

# --- Logging ------------------------------------------------------------
MODELFORGE_LOG_LEVEL=INFO
# Set true only in development. When false (default), user_request text is
# truncated in structured logs.
MODELFORGE_LOG_FULL_PROMPTS=false

# --- Resource monitor (prototype: VRAM cannot be reliably auto-detected) ----
MODELFORGE_ASSUMED_VRAM_GB=0
MODELFORGE_GPU_AVAILABLE=false

# --- CORS ---------------------------------------------------------------
MODELFORGE_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Provider credentials ----------------------------------------------
# A Provider's `credential_reference` is a lookup key into THIS environment,
# not a raw secret stored in the database. Example: if you register a
# provider with credential_reference="MY_PROVIDER_API_KEY", set it here:
# MY_PROVIDER_API_KEY=sk-...
